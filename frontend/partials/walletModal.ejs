<!-- Wallet Modal -->
<div class="wallet-modal" id="walletModal" aria-hidden="true">
  <div class="wallet-backdrop" data-wallet-close></div>

  <div class="wallet-panel" role="dialog" aria-modal="true" aria-labelledby="walletTitle">
    <button class="wallet-close" type="button" aria-label="Close" data-wallet-close>✕</button>

    <h2 class="wallet-title" id="walletTitle">My Wallet</h2>

    <!-- MAIN VIEW -->
    <section class="wallet-view is-active" data-view="main">
      <div class="wallet-row">
        <span class="wallet-label">Current balance</span>
        <span class="wallet-value">$ <span id="walletBalanceMain">300</span></span>
      </div>

      <div class="wallet-actions">
        <button class="wallet-btn" type="button" data-open-view="deposit">Deposit</button>
        <button class="wallet-btn" type="button" data-open-view="withdraw">Withdraw</button>
      </div>
    </section>

    <!-- DEPOSIT VIEW -->
    <section class="wallet-view" data-view="deposit">
      <button class="wallet-back" type="button" data-open-view="main">← Back</button>

      <h3 class="wallet-subtitle">Deposit</h3>

      <div class="wallet-row">
        <span class="wallet-label">Current balance</span>
        <span class="wallet-value">$ <span id="walletBalanceDeposit">300</span></span>
      </div>

      <div class="wallet-row">
        <span class="wallet-label">New balance</span>
        <span class="wallet-value wallet-green">$ <span id="walletNewDeposit">300</span></span>
      </div>

      <input id="depositAmount" class="wallet-input" type="number" min="0" placeholder="Deposit amount" />

      <button class="wallet-confirm" type="button" id="confirmDeposit">Confirm Deposit</button>
    </section>

    <!-- WITHDRAW VIEW -->
    <section class="wallet-view" data-view="withdraw">
      <button class="wallet-back" type="button" data-open-view="main">← Back</button>

      <h3 class="wallet-subtitle">Withdraw</h3>

      <div class="wallet-row">
        <span class="wallet-label">Current balance</span>
        <span class="wallet-value">$ <span id="walletBalanceWithdraw">300</span></span>
      </div>

      <div class="wallet-row">
        <span class="wallet-label">New balance</span>
        <span class="wallet-value wallet-red">$ <span id="walletNewWithdraw">300</span></span>
      </div>

      <input id="withdrawAmount" class="wallet-input" type="number" min="0" placeholder="Withdraw amount" />

      <button class="wallet-confirm" type="button" id="confirmWithdraw">Confirm Withdraw</button>
    </section>
  </div>
</div>

<script>
(function () {
  const modal = document.getElementById("walletModal");
  if (!modal) return;

  let balance = 300;

  const views = modal.querySelectorAll("[data-view]");

  const balMain = modal.querySelector("#walletBalanceMain");
  const balDep  = modal.querySelector("#walletBalanceDeposit");
  const balWit  = modal.querySelector("#walletBalanceWithdraw");

  const newDep  = modal.querySelector("#walletNewDeposit");
  const newWit  = modal.querySelector("#walletNewWithdraw");

  const depInput = modal.querySelector("#depositAmount");
  const witInput = modal.querySelector("#withdrawAmount");

  const confirmDeposit = modal.querySelector("#confirmDeposit");
  const confirmWithdraw = modal.querySelector("#confirmWithdraw");

  function showView(name) {
    views.forEach(v => v.classList.toggle("is-active", v.dataset.view === name));
  }

  function renderBalances() {
    if (balMain) balMain.textContent = balance;
    if (balDep) balDep.textContent = balance;
    if (balWit) balWit.textContent = balance;
    if (newDep) newDep.textContent = balance;
    if (newWit) newWit.textContent = balance;
  }

  function openModal() {
    modal.classList.add("is-open");
    modal.setAttribute("aria-hidden", "false");
    showView("main");
    renderBalances();
    if (depInput) depInput.value = "";
    if (witInput) witInput.value = "";
  }

  function closeModal() {
    modal.classList.remove("is-open");
    modal.setAttribute("aria-hidden", "true");
    showView("main");
  }

  // Make global function you can call from navbar button
  window.openWallet = openModal;

  modal.addEventListener("click", (e) => {
    if (e.target.closest("[data-wallet-close]")) closeModal();

    const openBtn = e.target.closest("[data-open-view]");
    if (openBtn) {
      const view = openBtn.dataset.openView;
      showView(view);
      renderBalances();
      if (depInput) depInput.value = "";
      if (witInput) witInput.value = "";
    }
  });

  depInput?.addEventListener("input", () => {
    const v = Math.max(0, Number(depInput.value || 0));
    newDep.textContent = balance + v;
  });

  witInput?.addEventListener("input", () => {
    const v = Math.max(0, Number(witInput.value || 0));
    newWit.textContent = Math.max(0, balance - v);
  });

  confirmDeposit?.addEventListener("click", () => {
    const v = Math.max(0, Number(depInput.value || 0));
    balance += v;
    renderBalances();
    showView("main");
  });

  confirmWithdraw?.addEventListener("click", () => {
    const v = Math.max(0, Number(witInput.value || 0));
    balance = Math.max(0, balance - v);
    renderBalances();
    showView("main");
  });

})();
</script>
