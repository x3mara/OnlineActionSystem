<div class="wallet-modal" id="sellModal" aria-hidden="true">
  <div class="wallet-modal__backdrop" data-close="sell"></div>

  <div class="wallet-modal__panel" role="dialog" aria-modal="true" aria-labelledby="sellTitle">
    <button class="wallet-modal__close" type="button" aria-label="Close" data-close="sell">✕</button>

    <h2 class="wallet-modal__title" id="sellTitle">Sell item</h2>

    <!-- Form wrapper (same fields as the standalone SellItem page) -->
    <form id="sellForm" class="sell-form" action="/sellitemI" method="POST" enctype="multipart/form-data">
      <div class="sell-grid">
        <!-- LEFT -->
        <div class="sell-left">
          <h3 class="sell-section">Details</h3>

          <label class="sell-label" for="sellName">Name</label>
          <input
            class="sell-input"
            id="sellName"
            name="name"
            type="text"
            placeholder="Name"
            autocomplete="off"
            required
          />

          <label class="sell-label" for="sellDesc">Description</label>
          <textarea
            class="sell-textarea"
            id="sellDesc"
            name="description"
            rows="6"
            placeholder="Description"
            required
          ></textarea>

          <h3 class="sell-section">Prices</h3>
          <div class="sell-row">
            <div>
              <label class="sell-label" for="sellBuyout">Buyout price</label>
              <input
                class="sell-input"
                id="sellBuyout"
                name="buyout_price"
                type="number"
                min="0"
                step="0.01"
                placeholder="Buyout price"
              />
            </div>
            <div>
              <label class="sell-label" for="sellStart">Starting price</label>
              <input
                class="sell-input"
                id="sellStart"
                name="starting_price"
                type="number"
                min="0"
                step="0.01"
                placeholder="Starting price"
                required
              />
            </div>
          </div>

          <h3 class="sell-section">Duration</h3>
          <label class="sell-label" for="sellEndDate">End date</label>
          <input
            class="sell-input"
            id="sellEndDate"
            name="end_date"
            type="datetime-local"
            required
          />
        </div>

        <!-- RIGHT -->
        <div class="sell-right">
          <div class="upload-box" id="uploadBox">
            <input
              id="sellImages"
              name="images"
              type="file"
              accept="image/*"
              multiple
              hidden
            />

            <button class="upload-btn" id="uploadBtn" type="button">Upload</button>
            <p class="upload-hint" id="uploadHint">Choose 1–5 images</p>

            <div class="upload-previews" id="uploadPreviews" aria-label="Selected images"></div>
          </div>

          <div class="tag-circles" id="tagCircles" aria-label="Select tags">
            <button class="tag-circle" data-tag="Game" type="button" title="Game">
              <img src="/static/public/Icons/game.png" alt="Game" loading="lazy" />
            </button>
            <button class="tag-circle" data-tag="Furniture" type="button" title="Furniture">
              <img src="/static/public/Icons/furniture.png" alt="Furniture" loading="lazy" />
            </button>
            <button class="tag-circle" data-tag="Accessories" type="button" title="Accessories">
              <img src="/static/public/Icons/accessories.png" alt="Accessories" loading="lazy" />
            </button>
            <button class="tag-circle" data-tag="Electronics" type="button" title="Electronics">
              <img src="/static/public/Icons/electronics.png" alt="Electronics" loading="lazy" />
            </button>
            <button class="tag-circle" data-tag="Vehicles" type="button" title="Vehicles">
              <img src="/static/public/Icons/vehicles.png" alt="Vehicles" loading="lazy" />
            </button>
          </div>

          <div class="tag-selected" id="tagSelected">Selected: none</div>

          <!-- Hidden field sent to backend -->
          <input type="hidden" id="sellTag" name="tag" value="" />

          <div class="sell-actions">
            <button class="cta sell-submit" type="submit" id="sellSubmit">Create auction</button>
          </div>
        </div>
      </div>
    </form>

  </div>
</div>

<script>
  // Setup upload previews and tag selection for the modal
  (function(){
    const uploadBtn = document.getElementById('uploadBtn');
    const sellImages = document.getElementById('sellImages');
    const previews = document.getElementById('uploadPreviews');
    const hint = document.getElementById('uploadHint');

    if (uploadBtn && sellImages) uploadBtn.addEventListener('click', () => sellImages.click());

    if (sellImages) sellImages.addEventListener('change', () => {
      previews.innerHTML = '';

      const files = [...sellImages.files].slice(0, 5);

      if (files.length === 0) {
        hint.textContent = 'Choose 1–5 images';
        return;
      }

      hint.textContent = `${files.length} image${files.length > 1 ? 's' : ''} selected`;

      files.forEach((file) => {
        if (!file.type.startsWith('image/')) return;

        const url = URL.createObjectURL(file);

        const img = document.createElement('img');
        img.src = url;
        img.alt = file.name;
        img.className = 'upload-thumb';

        img.onload = () => URL.revokeObjectURL(url);

        previews.appendChild(img);
      });
    });

    const tagSelected = document.getElementById('tagSelected');
    const sellTag = document.getElementById('sellTag');
    const circles = document.querySelectorAll('.tag-circle');

    function updateSelected() {
      const active = [...circles].find(c => c.classList.contains('active'));
      const tag = active ? active.dataset.tag : '';
      if (tagSelected) tagSelected.textContent = tag ? ("Selected: " + tag) : "Selected: none";
      if (sellTag) sellTag.value = tag;
    }

    circles.forEach(c => {
      c.addEventListener('click', () => {
        circles.forEach(t => t.classList.remove('active'));
        c.classList.add('active');
        updateSelected();
      });
    });

    updateSelected();

    const form = document.getElementById('sellForm');
    if (form) form.addEventListener('submit', (e) => {
      if (!sellTag.value) {
        e.preventDefault();
        alert('Please select one tag.');
        return;
      }

      const files = sellImages.files ? [...sellImages.files] : [];
      if (files.length < 1 || files.length > 5) {
        e.preventDefault();
        alert('Please upload 1–5 images.');
        return;
      }
    });

    // Close on Escape specifically inside modal
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const modal = document.getElementById('sellModal');
        if (modal && modal.classList.contains('is-open')) {
          modal.classList.remove('is-open');
          modal.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }
      }
    });
  })();
</script>