<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Manage Profile - 1X BID</title>
  <link rel="stylesheet" href="/static/public/styles.css" />
</head>

<body class="dashboard-body">
  <%- include('./partials/navbar.ejs') %>
  <main class="dashboard-main">
    <section class="manage-profile">
      <h2 class="manage-title">Manage profile</h2>


      <div class="manage-card">
        <div class="manage-avatar">
          <img id="avatarImg" src="<%= avatar %>" alt="avatar" />
          <div class="avatar-actions">
            <label class="change-btn" for="profilePic">Change picture</label>
            <input id="profilePic" name="profilePic" type="file" accept="image/*" class="file-input" />
            <div class="muted">PNG/JPG — max 5MB</div>
          </div>
        </div>

        <form action="/manageprofile" method="POST" enctype="multipart/form-data" class="manage-form">
          <div class="field-row">
            <label for="username">Username</label>
            <input id="username" name="username" type="text" value="<%= username %>" required />
          </div>

          <div class="form-actions">
            <a href="/clientdashboard" class="btn btn-ghost">Cancel</a>
            <button type="submit" class="btn">Save changes</button>
          </div>
        </form>
      </div>
    </section>
  </main>

  <script>
    (function(){
      const fileInput = document.getElementById('profilePic');
      const img = document.getElementById('avatarImg');
      if (!fileInput || !img) return;

      // preview selected image
      fileInput.addEventListener('change', () => {
        const f = fileInput.files && fileInput.files[0];
        if (!f) return;
        if (!f.type.startsWith('image/')) return;
        img.src = URL.createObjectURL(f);
      });
    })();
  </script>
</body>
</html>