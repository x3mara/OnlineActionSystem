<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Manage Profile - 1X BID</title>
  <link rel="stylesheet" href="/static/public/styles.css" />
</head>

<body class="dashboard-body">
  <%- include('./partials/navbar.ejs') %>
  <main class="dashboard-main">
    <section class="manage-profile">
      <h2 class="manage-title">Manage profile</h2>

<form action="/manageprofile" method="POST" enctype="multipart/form-data" class="manage-form">
      <div class="manage-card">
        <div class="manage-avatar">
          <img id="avatarImg" src="<%= avatar %>" alt="avatar" />

          <div class="upload-box" id="avatarUploadBox">
            <input id="profilePic" name="profilePic" type="file" accept="image/*" hidden />

            <button class="upload-btn" id="avatarUploadBtn" type="button">Change picture</button>

            <div class="upload-previews" id="avatarUploadPreviews" aria-label="Selected image"></div>
          </div>
        </div>

        
          <div class="field-row">
            <label for="username">Username</label>
            <input id="username" name="username" type="text" value="<%= username %>" required />
          </div>

          <div class="form-actions">
            <a href="/clientdashboard" class="btn btn-ghost">Cancel</a>
            <button type="submit" class="btn">Save changes</button>
          </div>
        </form>
      </div>
    </section>
  </main>

  <script>
    (function(){
      const fileInput = document.getElementById('profilePic');
      const img = document.getElementById('avatarImg');
      const uploadBtn = document.getElementById('avatarUploadBtn');
      const hint = document.getElementById('avatarUploadHint');
      const previews = document.getElementById('avatarUploadPreviews');
      if (!fileInput || !img || !uploadBtn) return;

      // open file dialog
      uploadBtn.addEventListener('click', () => fileInput.click());

      // preview selected image (single file)
      fileInput.addEventListener('change', () => {
        const f = fileInput.files && fileInput.files[0];
        previews.innerHTML = '';
        if (!f) {
          hint.textContent = 'PNG/JPG — max 5MB';
          return;
        }
        if (!f.type.startsWith('image/')) {
          hint.textContent = 'Please select an image file';
          return;
        }

        hint.textContent = f.name;
        const url = URL.createObjectURL(f);

        // update main avatar
        img.src = url;

        // show thumbnail in previews (reusing upload preview styles)
        const thumb = document.createElement('img');
        thumb.src = url;
        thumb.alt = f.name;
        thumb.className = 'upload-thumb';
        thumb.onload = () => URL.revokeObjectURL(url);
        previews.appendChild(thumb);
      });
    })();
  </script>
</body>
</html>