<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Sell item – 1X BID</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="styles.css" />
</head>

<body class="dashboard-body">

  <div class="modal-backdrop open" id="sellModal" aria-hidden="false">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="sellTitle">
      <button class="modal-x" id="sellCloseBtn" aria-label="Close">×</button>

      <h2 class="modal-title" id="sellTitle">Sell item</h2>

      <div class="sell-grid">
        <!-- LEFT -->
        <div class="sell-left">
          <h3 class="sell-section">Details</h3>

          <label class="sell-label" for="sellName">Name</label>
          <input class="sell-input" id="sellName" type="text" placeholder="Name" autocomplete="off" />

          <label class="sell-label" for="sellDesc">Description</label>
          <textarea class="sell-textarea" id="sellDesc" rows="6" placeholder="Description"></textarea>

          <h3 class="sell-section">Prices</h3>
          <div class="sell-row">
            <div>
              <label class="sell-label" for="sellBuyout">Buyout price</label>
              <input class="sell-input" id="sellBuyout" type="number" min="0" placeholder="Buyout price" />
            </div>
            <div>
              <label class="sell-label" for="sellStart">Starting price</label>
              <input class="sell-input" id="sellStart" type="number" min="0" placeholder="Starting price" />
            </div>
          </div>

          <h3 class="sell-section">Duration</h3>
          <label class="sell-label" for="sellEndDate">End date</label>
          <input class="sell-input" id="sellEndDate" type="datetime-local" />
        </div>

        <!-- RIGHT -->
        <div class="sell-right">
          <div class="upload-box" id="uploadBox">
            <input id="sellImages" type="file" accept="image/*" multiple hidden />

            <button class="upload-btn" id="uploadBtn" type="button">Upload</button>
            <p class="upload-hint" id="uploadHint">Choose 1–5 images</p>

            <div class="upload-previews" id="uploadPreviews" aria-label="Selected images"></div>
          </div>

          <div class="tag-circles" id="tagCircles" aria-label="Select tags">
            <button class="tag-circle" data-tag="Game" type="button" title="Game">
              <img src="Icons/game.png" alt="Game" loading="lazy" />
            </button>
            <button class="tag-circle" data-tag="Furniture" type="button" title="Furniture">
              <img src="Icons/furniture.png" alt="Furniture" loading="lazy" />
            </button>
            <button class="tag-circle" data-tag="Accessories" type="button" title="Accessories">
              <img src="Icons/accessories.png" alt="Accessories" loading="lazy" />
            </button>
            <button class="tag-circle" data-tag="Electronics" type="button" title="Electronics">
              <img src="Icons/electronics.png" alt="Electronics" loading="lazy" />
            </button>
            <button class="tag-circle" data-tag="Vehicles" type="button" title="Vehicles">
              <img src="Icons/vehicles.png" alt="Vehicles" loading="lazy" />
            </button>
          </div>

          <div class="tag-selected" id="tagSelected">Selected: none</div>

          <div class="sell-actions">
            <button class="cta sell-submit" type="button" id="sellSubmit">Create auction</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ✅ ONE script only -->
  <script>
    // Close = go back
    document.getElementById('sellCloseBtn').addEventListener('click', () => history.back());

    // Upload previews
    const uploadBtn = document.getElementById('uploadBtn');
    const sellImages = document.getElementById('sellImages');
    const previews = document.getElementById('uploadPreviews');
    const hint = document.getElementById('uploadHint');

    uploadBtn.addEventListener('click', () => sellImages.click());

    sellImages.addEventListener('change', () => {
      previews.innerHTML = '';

      const files = [...sellImages.files].slice(0, 5);

      if (files.length === 0) {
        hint.textContent = 'Choose 1–5 images';
        return;
      }

      hint.textContent = `${files.length} image${files.length > 1 ? 's' : ''} selected`;

      files.forEach((file) => {
        if (!file.type.startsWith('image/')) return;

        const url = URL.createObjectURL(file);

        const img = document.createElement('img');
        img.src = url;
        img.alt = file.name;
        img.className = 'upload-thumb';

        img.onload = () => URL.revokeObjectURL(url);

        previews.appendChild(img);
      });
    });

    // Tags toggle
    const tagSelected = document.getElementById('tagSelected');
    const circles = document.querySelectorAll('.tag-circle');

    function updateSelected() {
      const active = [...circles]
        .filter(c => c.classList.contains('active'))
        .map(c => c.dataset.tag);

      tagSelected.textContent = active.length ? ("Selected: " + active.join(", ")) : "Selected: none";
    }

    circles.forEach(c => {
        c.addEventListener('click', () => {
        // remove active from all tags
        circles.forEach(t => t.classList.remove('active'));

        // activate the clicked one
        c.classList.add('active');

    updateSelected();
  });
});

    updateSelected();

    // Demo submit
    document.getElementById('sellSubmit').addEventListener('click', () => {
      alert('Auction created (demo). Hook this to backend later.');
      history.back();
    });

    // ESC = go back
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') history.back();
    });
  </script>

</body>
</html>
